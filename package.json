{
  "name": "olmart-marketplace",
  "version": "1.0.0",
  "description": "OLMART Marketplace - E-commerce Platform",
  "author": "OLMART",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "prepare": "node -e \"try { if (require('fs').existsSync('.git')) { const { execSync } = require('child_process'); execSync('npx husky', { stdio: 'ignore' }); } } catch(e) {}\"",
    "build:client": "vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "PLAYWRIGHT_BROWSERS_PATH=0 playwright test",
    "lint": "NODE_OPTIONS=\"--max-old-space-size=1024\" eslint \"{src,scripts}/**/*.{ts,tsx}\" server.ts app.ts",
    "typecheck": "NODE_OPTIONS=\"--max-old-space-size=1536\" node ./node_modules/typescript/bin/tsc --noEmit",
    "typecheck:client": "NODE_OPTIONS=\"--max-old-space-size=1536\" node ./node_modules/typescript/bin/tsc -p tsconfig.client.json --noEmit",
    "typecheck:node": "NODE_OPTIONS=\"--max-old-space-size=1536\" node ./node_modules/typescript/bin/tsc -p tsconfig.node.json --noEmit",
    "format": "prettier --write \"{src,scripts}/**/*.{js,jsx,ts,tsx,css,md}\" server.ts app.ts",
    "backup:firestore": "tsx scripts/backup-firestore.ts",
    "check:translations": "tsx scripts/check-seller-translations.ts",
    "seed:real-estate": "tsx scripts/seed-real-estate.ts",
    "validate:assets": "node scripts/validate-assets.mjs",
    "audit:ci": "npm ci && npm audit --omit=dev --audit-level=high"
  },
  "packageManager": "npm@10.9.4",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10 <11"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{css,md}": [
      "prettier --write"
    ]
  },
