rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // 1. SÉCURITÉ PAR DÉFAUT (Default Deny Catch-All)
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // 2. FONCTIONS HELPERS DE BASE ET CONTRÔLE D'ACCÈS (RBAC)
    // =========================================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserData() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : null;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token != null && ('role' in request.auth.token && request.auth.token.role == 'admin' || 'admin' in request.auth.token && request.auth.token.admin == true)) ||
        (getUserData() != null && 'role' in getUserData() && getUserData().role == 'admin')
      );
    }

    function isSeller() {
      return isSignedIn() && (
        (request.auth.token != null && 'role' in request.auth.token && request.auth.token.role == 'seller') ||
        (getUserData() != null && 'role' in getUserData() && (getUserData().role == 'seller' || getUserData().role == 'artisan'))
      );
    }

    function isArtisan() {
      return isSignedIn() && (
        (request.auth.token != null && 'role' in request.auth.token && request.auth.token.role == 'artisan') ||
        (getUserData() != null && 'role' in getUserData() && getUserData().role == 'artisan')
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // =========================================================================
    // 3. COLLECTION USERS (Profils, Paniers, Favoris)
    // =========================================================================
    match /users/{userId} {
      // Lecture : autorisée à tout utilisateur authentifié (ou admin)
      allow read: if isSignedIn();

      // Création : autorisée pour l'utilisateur sur son propre document (ex: premier login Google/Email)
      allow create: if isOwner(userId);

      // Mise à jour : autorisée pour l'utilisateur sur son propre profil ou pour un administrateur
      allow update: if isOwner(userId) || isAdmin();

      // Suppression : strictement réservée aux administrateurs
      allow delete: if isAdmin();

      // Sous-collections utilisateur
      match /cart/{id} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /wishlist/{id} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /following/{id} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // Profils publics (Vendeurs / Artisans)
    match /publicProfiles/{id} {
      allow read: if true;
      allow write: if isOwner(id) || isAdmin();
    }

    match /public_profiles/{id} {
      allow read: if true;
      allow write: if isOwner(id) || isAdmin();
    }

    match /user_habits/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // =========================================================================
    // 4. COLLECTION PRODUCTS (Marketplace)
    // =========================================================================
    match /products/{productId} {
      // Lecture publique
      allow read: if true;

      // Écriture : réservée aux vendeurs, artisans ou administrateurs
      allow create: if isSeller() || isArtisan() || isAdmin();
      allow update: if (isSeller() && (existing().sellerId == request.auth.uid || !('sellerId' in existing()))) || isArtisan() || isAdmin();
      allow delete: if (isSeller() && existing().sellerId == request.auth.uid) || isAdmin();
    }

    match /product_history/{id} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.sellerId == request.auth.uid);
      allow create: if isSeller() || isAdmin();
      allow update, delete: if isAdmin();
    }

    // =========================================================================
    // 5. COLLECTION ORDERS & SOUS-COLLECTIONS (Commandes)
    // =========================================================================
    match /order_masters/{masterId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /orders/{orderId} {
      // Création : autorisée pour tout utilisateur connecté
      allow create: if isSignedIn();

      // Lecture : autorisée pour l'acheteur, les vendeurs de la commande ou l'administrateur
      allow read: if isSignedIn() && (
        resource.data.buyerId == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        isAdmin() ||
        (isSeller() && ('sellerIds' in resource.data) && request.auth.uid in resource.data.sellerIds) ||
        (isSeller() && ('sellerId' in resource.data) && resource.data.sellerId == request.auth.uid)
      );

      // Mise à jour : autorisée pour le client (gestion des litiges / retours), le vendeur ou l'admin
      allow update: if isSignedIn() && (
        isAdmin() ||
        resource.data.buyerId == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        (isSeller() && ('sellerIds' in resource.data) && request.auth.uid in resource.data.sellerIds) ||
        (isSeller() && ('sellerId' in resource.data) && resource.data.sellerId == request.auth.uid)
      );

      allow delete: if isAdmin();

      // Sous-collections de commande
      match /order_logs/{logId} {
        allow read: if isSignedIn() && (
          get(/databases/$(database)/documents/orders/$(orderId)).data.buyerId == request.auth.uid ||
          get(/databases/$(database)/documents/orders/$(orderId)).data.userId == request.auth.uid ||
          isAdmin() ||
          (isSeller() && request.auth.uid in get(/databases/$(database)/documents/orders/$(orderId)).data.sellerIds)
        );
        allow write: if isAdmin() || isSignedIn();
      }

      match /messages/{messageId} {
        allow read: if isSignedIn() && (
          get(/databases/$(database)/documents/orders/$(orderId)).data.buyerId == request.auth.uid ||
          get(/databases/$(database)/documents/orders/$(orderId)).data.userId == request.auth.uid ||
          isAdmin() ||
          (isSeller() && request.auth.uid in get(/databases/$(database)/documents/orders/$(orderId)).data.sellerIds)
        );
        allow create: if isSignedIn();
        allow update, delete: if isAdmin();
      }
    }

    match /confirmed_delivery_info/{refId} {
      allow get: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow list: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /withdrawals/{id} {
      allow read: if isSignedIn() && (resource.data.sellerId == request.auth.uid || isAdmin());
      allow create: if isSeller() || isAdmin();
      allow update, delete: if isAdmin();
    }

    // =========================================================================
    // 6. COLLECTIONS PUBLIQUES ET CONFIGURATIONS (Lecture publique, Admin écriture)
    // =========================================================================
    match /banners/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /homepage_categories_v2/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /homepage_sections/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /homepage_versions/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /global_settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /public_configs/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /ui_elements/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /tags/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /coupons/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /reviews/{id} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    match /site_content_monthly/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /platform_stats/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /seasonal_themes/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /public/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /metadata/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // =========================================================================
    // 7. NOTIFICATIONS & SUPPORT
    // =========================================================================
    match /user_notifications/{notifId} {
      allow read: if isSignedIn() && resource.data.recipientId == request.auth.uid;
      allow create: if isAdmin() || isSignedIn();
      allow update: if isSignedIn() && resource.data.recipientId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.recipientId == request.auth.uid;
    }

    match /internal_notifications/{notifId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /seller_support/{supportId} {
      allow read: if isSignedIn() && (resource.data.sellerId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && incoming().sellerId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /buyer_support/{supportId} {
      allow read: if isSignedIn() && (resource.data.buyerId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && incoming().buyerId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /support_tickets/{id} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /supportTickets/{id} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn();
      allow update: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /supportMessages/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /disputeMessages/{id} {
      allow read, create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /login_history/{id} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /site_errors/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /sponsorship_requests/{id} {
      allow read: if isAdmin() || (isSeller() && resource.data.sellerId == request.auth.uid);
      allow create: if isSeller() || isAdmin();
      allow update, delete: if isAdmin();
    }

    match /admin_alerts/{id} {
      allow read, write: if isAdmin();
    }

    match /analytics/{id} {
      allow read, write: if isAdmin();
    }

    match /analytics_events/{id} {
      allow read, write: if isAdmin();
    }

    match /admin_activities/{id} {
      allow read, write: if isAdmin();
    }

    match /audit_logs/{id} {
      allow read, write: if isAdmin();
    }

    match /newsletter_campaigns/{id} {
      allow read, write: if isAdmin();
    }

    match /newsletter_subscribers/{id} {
      allow read, write: if isAdmin();
    }

    match /newsletterEmails/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // =========================================================================
    // 8. MODULES ADDITIONNELS (OlmaBricolage, OlmaImmo, Messagerie Unifiée)
    // =========================================================================
    match /bricolage_categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /bricolage_artisans/{artisanId} {
      allow read: if true;
      allow create, update: if isOwner(artisanId) || isArtisan() || isAdmin();
      allow delete: if isAdmin();
    }

    match /bricolage_quote_requests/{requestId} {
      allow read: if isAdmin() || (isSignedIn() && (resource.data.customerId == request.auth.uid || resource.data.artisanId == request.auth.uid));
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.customerId == request.auth.uid);
    }

    match /bricolage_reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /real_estate_properties/{propertyId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.ownerId == request.auth.uid);
    }

    match /real_estate_bookings/{bookingId} {
      allow read: if isAdmin() || (isSignedIn() && (resource.data.tenantId == request.auth.uid || resource.data.ownerId == request.auth.uid));
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || (isSignedIn() && (resource.data.tenantId == request.auth.uid || resource.data.ownerId == request.auth.uid));
    }

    match /real_estate_visits/{visitId} {
      allow read: if isAdmin() || (isSignedIn() && (resource.data.visitorId == request.auth.uid || resource.data.ownerId == request.auth.uid));
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || (isSignedIn() && (resource.data.visitorId == request.auth.uid || resource.data.ownerId == request.auth.uid));
    }

    match /conversations/{conversationId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid in resource.data.participants);
      allow create: if isSignedIn();
      allow update: if isAdmin() || (isSignedIn() && request.auth.uid in resource.data.participants);
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read, create: if isAdmin() || (
          isSignedIn() &&
          exists(/databases/$(database)/documents/conversations/$(conversationId)) &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
        );
        allow update, delete: if isAdmin();
      }
    }

  }
}
