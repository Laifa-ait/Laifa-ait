rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // 1. SÉCURITÉ PAR DÉFAUT (Default Deny Catch-All)
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // 2. FONCTIONS HELPERS DE BASE ET CONTRÔLE D'ACCÈS (RBAC)
    // =========================================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserData() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token != null && (
        ('admin' in request.auth.token && request.auth.token.admin == true) ||
        ('role' in request.auth.token && request.auth.token.role == 'admin')
      );
    }

    function isSeller() {
      return isSignedIn() && (
        (request.auth.token != null && 'role' in request.auth.token && request.auth.token.role == 'seller') ||
        (getUserData() != null && 'role' in getUserData() && (getUserData().role == 'seller' || getUserData().role == 'artisan'))
      );
    }

    function isArtisan() {
      return isSignedIn() && (
        (request.auth.token != null && 'role' in request.auth.token && request.auth.token.role == 'artisan') ||
        (getUserData() != null && 'role' in getUserData() && getUserData().role == 'artisan')
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // =========================================================================
    // 3. COLLECTION USERS (Profils, Paniers, Favoris)
    // =========================================================================
    match /users/{userId} {
      // Lecture : strictement réservée au propriétaire du profil ou à un administrateur
      allow read: if isOwner(userId) || isAdmin();

      // Création : autorisée pour l'utilisateur sur son propre document (sans élévation de rôle/privilèges/MFA)
      allow create: if isOwner(userId) && (
        !('role' in incoming()) || incoming().role in ['buyer', 'client']
      ) && (
        !('status' in incoming()) || incoming().status == 'pending'
      ) && (
        !('capabilities' in incoming())
      ) && (
        !('verification' in incoming())
      ) && (
        !('is2FAEnabled' in incoming())
      ) && (
        !('twoFactorSecret' in incoming())
      ) && (
        !('mfa' in incoming())
      ) && (
        !('soldes' in incoming())
      );

      // Mise à jour : autorisée pour l'utilisateur sur son propre profil (champs sûrs uniquement) ou pour un administrateur
      allow update: if isAdmin() || (
        isOwner(userId) &&
        !incoming().diff(existing()).affectedKeys().hasAny(['role', 'status', 'capabilities', 'verification', 'is2FAEnabled', 'twoFactorSecret', 'mfa', 'soldes', 'balance', 'customClaims', 'permissions', 'commissionRate', 'isVerified', 'verified', 'kycStatus']) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'name', 'firstName', 'lastName', 'email', 'photoURL', 'avatar',
          'phone', 'phoneNumber', 'address', 'wilaya', 'commune', 'city', 'postalCode',
          'bio', 'description', 'updatedAt', 'lastLogin', 'lastLoginAt', 'theme', 'language',
          'preferences', 'shopName', 'shopDescription', 'shopLogo', 'shopBanner', 'shopAddress',
          'shopPhone', 'shopWilaya', 'shopCommune', 'documents', 'fcmToken', 'fcmTokens',
          'notificationsEnabled', 'socialLinks', 'website', 'commercialRegister', 'nif', 'nis',
          'rib', 'artisanCardNumber', 'specialties', 'experienceYears', 'portfolio', 'workingHours',
          'services', 'categories', 'avatarUrl', 'coverUrl', 'metadata', 'cart', 'wishlist', 'searchHistory'
        ])
      );

      // Suppression : strictement réservée aux administrateurs
      allow delete: if isAdmin();

      // Sous-collections utilisateur
      match /cart/{id} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /wishlist/{id} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /following/{id} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // Collections privées d'authentification et secrets OTP (strictement inaccessibles via SDK client)
    match /user_secrets/{userId} {
      allow read, write: if false;
    }

    match /private_auth/{userId} {
      allow read, write: if false;
    }

    // Profils publics (Vendeurs / Artisans)
    match /publicProfiles/{id} {
      allow read: if true;
      allow write: if isOwner(id) || isAdmin();
    }

    match /public_profiles/{id} {
      allow read: if true;
      allow write: if isOwner(id) || isAdmin();
    }

    match /user_habits/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // =========================================================================
    // 4. COLLECTION PRODUCTS (Marketplace)
    // =========================================================================
    match /products/{productId} {
      // Lecture publique conditionnée à status == "active" (brouillons, rejetés, archivés réservés au propriétaire et à l'admin)
      allow read: if resource.data.status == "active" || !('status' in resource.data) || isAdmin() || (isSignedIn() && (
        resource.data.sellerId == request.auth.uid ||
        resource.data.artisanId == request.auth.uid ||
        resource.data.userId == request.auth.uid
      ));

      // Écriture : réservée aux vendeurs, artisans ou administrateurs avec liaison obligatoire à l'UID de l'auteur
      allow create: if (isSeller() || isArtisan() || isAdmin()) && (
        isAdmin() ||
        ('sellerId' in incoming() && incoming().sellerId == request.auth.uid) ||
        ('artisanId' in incoming() && incoming().artisanId == request.auth.uid) ||
        ('userId' in incoming() && incoming().userId == request.auth.uid)
      );
      
      // Modification : réservée à l'administrateur ou au vendeur/artisan propriétaire du produit (interdiction de modifier le sellerId/artisanId/userId)
      allow update: if isAdmin() || (
        (
          (isSeller() && (existing().sellerId == request.auth.uid || existing().userId == request.auth.uid)) ||
          (isArtisan() && (existing().artisanId == request.auth.uid || existing().sellerId == request.auth.uid || existing().userId == request.auth.uid))
        ) &&
        (!('sellerId' in incoming()) || !('sellerId' in existing()) || incoming().sellerId == existing().sellerId) &&
        (!('artisanId' in incoming()) || !('artisanId' in existing()) || incoming().artisanId == existing().artisanId) &&
        (!('userId' in incoming()) || !('userId' in existing()) || incoming().userId == existing().userId)
      );

      // Suppression : réservée à l'administrateur ou au vendeur/artisan propriétaire
      allow delete: if isAdmin() || (
        (isSeller() && (existing().sellerId == request.auth.uid || existing().userId == request.auth.uid)) ||
        (isArtisan() && (existing().artisanId == request.auth.uid || existing().sellerId == request.auth.uid || existing().userId == request.auth.uid))
      );
    }

    match /product_history/{id} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.sellerId == request.auth.uid);
      allow create: if (isSeller() || isArtisan() || isAdmin()) && (
        isAdmin() ||
        ('sellerId' in incoming() && incoming().sellerId == request.auth.uid) ||
        ('userId' in incoming() && incoming().userId == request.auth.uid)
      );
      allow update, delete: if isAdmin();
    }

    // =========================================================================
    // 5. COLLECTION ORDERS & SOUS-COLLECTIONS (Commandes)
    // =========================================================================
    match /order_masters/{masterId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.buyerId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && (incoming().userId == request.auth.uid || incoming().buyerId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /orders/{orderId} {
      // Création : autorisée pour l'acheteur authentifié lié à son propre identifiant avec statut initial pending
      allow create: if isSignedIn() && (
        incoming().buyerId == request.auth.uid ||
        incoming().userId == request.auth.uid
      ) && (
        !('paymentStatus' in incoming()) || incoming().paymentStatus == 'pending'
      ) && (
        !('status' in incoming()) || incoming().status == 'pending'
      );

      // Lecture : autorisée pour l'acheteur, les vendeurs de la commande ou l'administrateur
      allow read: if isSignedIn() && (
        resource.data.buyerId == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        isAdmin() ||
        (isSeller() && ('sellerIds' in resource.data) && request.auth.uid in resource.data.sellerIds) ||
        (isSeller() && ('sellerId' in resource.data) && resource.data.sellerId == request.auth.uid)
      );

      // Mise à jour : autorisée pour l'acheteur ou le vendeur avec immuabilité stricte des prix, montants, articles, acheteur et données de paiement
      // Les mutations financières et changements de paiement sont réservés à l'Admin SDK transactionnel côté serveur
      allow update: if isSignedIn() && (
        isAdmin() || (
          (
            existing().buyerId == request.auth.uid ||
            existing().userId == request.auth.uid ||
            (isSeller() && ('sellerIds' in existing()) && request.auth.uid in existing().sellerIds) ||
            (isSeller() && ('sellerId' in existing()) && existing().sellerId == request.auth.uid)
          ) &&
          !incoming().diff(existing()).affectedKeys().hasAny([
            'buyerId', 'userId', 'sellerId', 'sellerIds', 'totalAmount', 'subtotal', 'total',
            'items', 'price', 'paymentStatus', 'paymentMethod', 'paidAt', 'commission', 'createdAt'
          ]) &&
          (!('buyerId' in incoming()) || incoming().buyerId == existing().buyerId) &&
          (!('userId' in incoming()) || incoming().userId == existing().userId)
        )
      );

      allow delete: if isAdmin();

      // Sous-collections de commande
      match /order_logs/{logId} {
        allow read: if isSignedIn() && (
          get(/databases/$(database)/documents/orders/$(orderId)).data.buyerId == request.auth.uid ||
          get(/databases/$(database)/documents/orders/$(orderId)).data.userId == request.auth.uid ||
          isAdmin() ||
          (isSeller() && request.auth.uid in get(/databases/$(database)/documents/orders/$(orderId)).data.sellerIds)
        );
        allow write: if isAdmin() || (
          isSignedIn() && (
            get(/databases/$(database)/documents/orders/$(orderId)).data.buyerId == request.auth.uid ||
            get(/databases/$(database)/documents/orders/$(orderId)).data.userId == request.auth.uid ||
            (isSeller() && request.auth.uid in get(/databases/$(database)/documents/orders/$(orderId)).data.sellerIds)
          )
        );
      }

      match /messages/{messageId} {
        allow read: if isSignedIn() && (
          get(/databases/$(database)/documents/orders/$(orderId)).data.buyerId == request.auth.uid ||
          get(/databases/$(database)/documents/orders/$(orderId)).data.userId == request.auth.uid ||
          isAdmin() ||
          (isSeller() && request.auth.uid in get(/databases/$(database)/documents/orders/$(orderId)).data.sellerIds)
        );
        allow create: if isSignedIn() && (
          isAdmin() ||
          (
            (
              get(/databases/$(database)/documents/orders/$(orderId)).data.buyerId == request.auth.uid ||
              get(/databases/$(database)/documents/orders/$(orderId)).data.userId == request.auth.uid ||
              (isSeller() && request.auth.uid in get(/databases/$(database)/documents/orders/$(orderId)).data.sellerIds)
            ) &&
            (!('senderId' in incoming()) || incoming().senderId == request.auth.uid)
          )
        );
        allow update, delete: if isAdmin();
      }
    }

    match /confirmed_delivery_info/{refId} {
      allow get: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow list: if isAdmin();
      allow create: if isSignedIn() && (!('userId' in incoming()) || incoming().userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /withdrawals/{id} {
      allow read: if isSignedIn() && (resource.data.sellerId == request.auth.uid || isAdmin());
      allow create: if (isSeller() || isAdmin()) && (!('sellerId' in incoming()) || incoming().sellerId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // =========================================================================
    // 6. COLLECTIONS PUBLIQUES ET CONFIGURATIONS (Lecture publique, Admin écriture)
    // =========================================================================
    match /banners/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /homepage_categories_v2/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /homepage_sections/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /homepage_versions/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{id} {
      allow read, write: if isAdmin();
    }

    match /global_settings/{id} {
      allow read, write: if isAdmin();
    }

    match /public_configs/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /ui_elements/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /tags/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /coupons/{id} {
      // Les coupons et historiques d'utilisation sont validés côté serveur uniquement (ou par l'admin / vendeur créateur)
      allow read: if isAdmin() || (isSignedIn() && (
        ('sellerId' in resource.data && resource.data.sellerId == request.auth.uid) ||
        ('createdBy' in resource.data && resource.data.createdBy == request.auth.uid) ||
        ('userId' in resource.data && resource.data.userId == request.auth.uid)
      ));
      allow write: if isAdmin();
    }

    match /reviews/{id} {
      allow read: if true;
      allow create: if isSignedIn() && (!('userId' in incoming()) || incoming().userId == request.auth.uid);
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    match /site_content_monthly/{id} {
      allow read, write: if isAdmin();
    }

    match /platform_stats/{id} {
      allow read, write: if isAdmin();
    }

    match /seasonal_themes/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /public/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /metadata/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // =========================================================================
    // 7. NOTIFICATIONS & SUPPORT
    // =========================================================================
    match /user_notifications/{notifId} {
      allow read: if isSignedIn() && resource.data.recipientId == request.auth.uid;
      allow create: if isAdmin() || isSignedIn();
      allow update: if isSignedIn() && resource.data.recipientId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.recipientId == request.auth.uid;
    }

    match /internal_notifications/{notifId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /seller_support/{supportId} {
      allow read: if isSignedIn() && (resource.data.sellerId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && incoming().sellerId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /buyer_support/{supportId} {
      allow read: if isSignedIn() && (resource.data.buyerId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && incoming().buyerId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /support_tickets/{id} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /supportTickets/{id} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn();
      allow update: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /supportMessages/{id} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        resource.data.userId == request.auth.uid ||
        resource.data.senderId == request.auth.uid
      );
      allow create: if isSignedIn() && (
        isAdmin() ||
        ('userId' in incoming() ? incoming().userId == request.auth.uid : true) ||
        ('senderId' in incoming() ? incoming().senderId == request.auth.uid : true)
      );
      allow update, delete: if isAdmin();
    }

    match /disputeMessages/{id} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        resource.data.buyerId == request.auth.uid ||
        resource.data.sellerId == request.auth.uid ||
        resource.data.senderId == request.auth.uid ||
        resource.data.userId == request.auth.uid
      );
      allow create: if isSignedIn() && (
        isAdmin() ||
        ('senderId' in incoming() ? incoming().senderId == request.auth.uid : true)
      );
      allow update, delete: if isAdmin();
    }

    match /login_history/{id} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /site_errors/{id} {
      allow create: if incoming().keys().hasOnly(['message', 'stack', 'url', 'timestamp', 'userAgent', 'error', 'createdAt', 'path'])
        && (!('message' in incoming()) || (incoming().message is string && incoming().message.size() <= 2000));
      allow read, update, delete: if isAdmin();
    }

    match /sponsorship_requests/{id} {
      allow read: if isAdmin() || (isSeller() && resource.data.sellerId == request.auth.uid);
      allow create: if isSeller() || isAdmin();
      allow update, delete: if isAdmin();
    }

    match /admin_alerts/{id} {
      allow read, write: if isAdmin();
    }

    match /analytics/{id} {
      allow read, write: if isAdmin();
    }

    match /analytics_events/{id} {
      allow read, write: if isAdmin();
    }

    match /admin_activities/{id} {
      allow read, write: if isAdmin();
    }

    match /audit_logs/{id} {
      allow read, write: if isAdmin();
    }

    match /newsletter_campaigns/{id} {
      allow read, write: if isAdmin();
    }

    match /newsletter_subscribers/{id} {
      allow read, write: if isAdmin();
    }

    match /newsletterEmails/{id} {
      allow create: if incoming().keys().hasOnly(['email', 'createdAt', 'source', 'timestamp', 'subscribed'])
        && incoming().email is string
        && incoming().email.size() <= 254;
      allow read, update, delete: if isAdmin();
    }

    // =========================================================================
    // 8. MODULES ADDITIONNELS (OlmaBricolage, OlmaImmo, Messagerie Unifiée)
    // =========================================================================
    match /bricolage_categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /bricolage_artisans/{artisanId} {
      allow read: if true;
      allow create: if (isOwner(artisanId) || isArtisan() || isAdmin()) && (
        artisanId == request.auth.uid ||
        ('userId' in incoming() && incoming().userId == request.auth.uid) ||
        ('id' in incoming() && incoming().id == request.auth.uid)
      );
      allow update: if isAdmin() || (
        (isOwner(artisanId) || (isArtisan() && (artisanId == request.auth.uid || existing().userId == request.auth.uid))) &&
        (!('userId' in incoming()) || !('userId' in existing()) || incoming().userId == existing().userId)
      );
      allow delete: if isAdmin();
    }

    match /bricolage_quote_requests/{requestId} {
      allow read: if isAdmin() || (isSignedIn() && (resource.data.customerId == request.auth.uid || resource.data.artisanId == request.auth.uid || ('userId' in resource.data && resource.data.userId == request.auth.uid)));
      allow create: if isSignedIn() && (
        ('customerId' in incoming() && incoming().customerId == request.auth.uid) ||
        ('userId' in incoming() && incoming().userId == request.auth.uid)
      );
      allow update: if isAdmin() || (
        isSignedIn() &&
        (existing().customerId == request.auth.uid || existing().artisanId == request.auth.uid || ('userId' in existing() && existing().userId == request.auth.uid)) &&
        !incoming().diff(existing()).affectedKeys().hasAny(['customerId', 'userId', 'artisanId', 'budget', 'price', 'amount'])
      );
      allow delete: if isAdmin();
    }

    match /bricolage_reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && (
        ('reviewerId' in incoming() && incoming().reviewerId == request.auth.uid) ||
        ('userId' in incoming() && incoming().userId == request.auth.uid) ||
        ('customerId' in incoming() && incoming().customerId == request.auth.uid) ||
        ('buyerId' in incoming() && incoming().buyerId == request.auth.uid)
      );
      allow update, delete: if isAdmin();
    }

    match /real_estate_properties/{propertyId} {
      allow read: if resource.data.status == "active" || resource.data.status == "published" || resource.data.status == "available" || !('status' in resource.data) || isAdmin() || (isSignedIn() && (
        resource.data.ownerId == request.auth.uid ||
        resource.data.userId == request.auth.uid
      ));
      allow create: if isSignedIn() && (
        ('ownerId' in incoming() && incoming().ownerId == request.auth.uid) ||
        ('userId' in incoming() && incoming().userId == request.auth.uid)
      );
      allow update: if isAdmin() || (
        isSignedIn() &&
        (existing().ownerId == request.auth.uid || ('userId' in existing() && existing().userId == request.auth.uid)) &&
        (!('ownerId' in incoming()) || !('ownerId' in existing()) || incoming().ownerId == existing().ownerId) &&
        (!('userId' in incoming()) || !('userId' in existing()) || incoming().userId == existing().userId)
      );
      allow delete: if isAdmin() || (isSignedIn() && (existing().ownerId == request.auth.uid || ('userId' in existing() && existing().userId == request.auth.uid)));
    }

    match /real_estate_bookings/{bookingId} {
      allow read: if isAdmin() || (isSignedIn() && (resource.data.tenantId == request.auth.uid || resource.data.ownerId == request.auth.uid || ('userId' in resource.data && resource.data.userId == request.auth.uid)));
      allow create: if isSignedIn() && (
        ('tenantId' in incoming() && incoming().tenantId == request.auth.uid) ||
        ('userId' in incoming() && incoming().userId == request.auth.uid)
      );
      allow update: if isAdmin() || (
        isSignedIn() &&
        (existing().tenantId == request.auth.uid || existing().ownerId == request.auth.uid || ('userId' in existing() && existing().userId == request.auth.uid)) &&
        !incoming().diff(existing()).affectedKeys().hasAny(['tenantId', 'userId', 'ownerId', 'price', 'totalPrice', 'amount', 'paymentStatus'])
      );
      allow delete: if isAdmin() || (isSignedIn() && (existing().tenantId == request.auth.uid || existing().ownerId == request.auth.uid || ('userId' in existing() && existing().userId == request.auth.uid)));
    }

    match /real_estate_visits/{visitId} {
      allow read: if isAdmin() || (isSignedIn() && (resource.data.visitorId == request.auth.uid || resource.data.ownerId == request.auth.uid || ('userId' in resource.data && resource.data.userId == request.auth.uid)));
      allow create: if isSignedIn() && (
        ('visitorId' in incoming() && incoming().visitorId == request.auth.uid) ||
        ('userId' in incoming() && incoming().userId == request.auth.uid)
      );
      allow update: if isAdmin() || (
        isSignedIn() &&
        (existing().visitorId == request.auth.uid || existing().ownerId == request.auth.uid || ('userId' in existing() && existing().userId == request.auth.uid)) &&
        (!('visitorId' in incoming()) || !('visitorId' in existing()) || incoming().visitorId == existing().visitorId) &&
        (!('ownerId' in incoming()) || !('ownerId' in existing()) || incoming().ownerId == existing().ownerId)
      );
      allow delete: if isAdmin() || (isSignedIn() && (existing().visitorId == request.auth.uid || existing().ownerId == request.auth.uid || ('userId' in existing() && existing().userId == request.auth.uid)));
    }

    match /conversations/{conversationId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid in resource.data.participants);
      allow create: if isSignedIn() && ('participants' in incoming()) && (request.auth.uid in incoming().participants);
      allow update: if isAdmin() || (
        isSignedIn() &&
        request.auth.uid in existing().participants &&
        (!('participants' in incoming()) || request.auth.uid in incoming().participants)
      );
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isAdmin() || (
          isSignedIn() &&
          exists(/databases/$(database)/documents/conversations/$(conversationId)) &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
        );
        allow create: if isAdmin() || (
          isSignedIn() &&
          exists(/databases/$(database)/documents/conversations/$(conversationId)) &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants &&
          ('senderId' in incoming() ? incoming().senderId == request.auth.uid : true)
        );
        allow update, delete: if isAdmin();
      }
    }

  }
}
