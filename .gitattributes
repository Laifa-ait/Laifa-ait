# Force line breaks to LF for cross-platform compatibility
* text=auto eol=lf

# Force specific directories and shell scripts to LF
.husky/* text eol=lf
*.sh text eol=lf
*.bash text eol=lf

# Binary files protection
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary

