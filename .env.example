# .env.example - OLMART MARKETPLACE CONFIGURATION
PORT=3000 # Server port (default: 3000 for AI Studio and Docker container)
CSRF_SECRET= # Required in production: 64-char random hex/base64 string
ALLOWED_ORIGINS= # Optional: Comma-separated list of exact additional allowed origins in production (e.g. https://olmart.dz)
GEMINI_API_KEY=
DELIVERY_API_KEY=
YALIDINE_WEBHOOK_SECRET=
DANGER_ZONE_SECRET= # Non-production only: secret key required to authorize danger-zone reset
RUN_MIGRATIONS=

# Google Maps Platform Configuration
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=

CSP_REPORT_ONLY=false # Do NOT set to true in production. Enforces strict CSP blocking in production.

# Minimum Order Amount (Backend is authoritative in Firestore transaction; Frontend for immediate UX feedback)
MIN_ORDER_AMOUNT=100
VITE_MIN_ORDER_AMOUNT=100

# ==============================================================================
# FIREBASE ENVIRONMENT CONFIGURATION (STAGING & PRODUCTION)
# ==============================================================================

# STAGING TARGET: olmart-staging-e2e
# PRODUCTION TARGET: original-micron-7sjh2

# Client (Vite Frontend)
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_ID=(default)
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Server (Node / Express Admin SDK)
FIREBASE_PROJECT_ID=
FIREBASE_DATABASE_ID=(default)
FIREBASE_SERVICE_ACCOUNT_KEY= # Paste valid Service Account JSON string or leave empty if using Google ADC

